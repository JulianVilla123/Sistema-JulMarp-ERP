DATABASE_URL=postgresql://usuario:contrasena@host:5432/base_de_datos
# En Vercel DATABASE_URL es obligatoria; usar la cadena PostgreSQL de Supabase.
# En desarrollo local se puede mantener SQLite con USE_SUPABASE_DB=false.
USE_SUPABASE_DB=false
USE_POSTGRES_DB=false
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
